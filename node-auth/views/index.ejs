<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    
    <style>
        *{
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        container{
            width: 300px;
            height: 400px; 
            border: solid black 1px;
            border-radius: 25px;
            background-color: cornsilk;
        }

        


    </style>
</head>
<body>

    <div class="container">

        <form id="login-form">
            <input type='text' id="username-login" required placeholder="Username">
            <input type='password' id='password-login' required placeholder="password"> 
            <input type="submit">
            <p id="login-span"></p>
        </form>

        <h2>Sing in</h2>
        <form id="register">
            <input type='text' id="username-register" required placeholder="Username">
            <input type='password' id='password-register' required placeholder="password"> 
            <input type="submit">
            <p id="register-span"></p>
        </form>

    </div>

    <script>
        const $ = el => document.querySelector(el)

        const loginForm = $('#login-form')
        const loginSpan = $('#login-span')

        const registerForm = $('register')
        const regsiterFormSapn = $('register-span')

        loginForm?.addEventListener('submit', e => {
            e.preventDefault()

            const username = $('#username-login')
            const password = $('#password-login')

            fetch('/login',{
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({username, password})
            })
            .then(res => {
                console.log('entonces')
                if(res.ok){
                    loginSpan.innerText = 'Sesión inciada... entrando ...'
                    loginSpan.style.color = 'green'
                    setTimeout(() => {
                        window.location.href = '/protected'
                    }, 2000)
                } else {
                    loginSpan.innerTExt = 'Error al inciar sesión'
                    loginSpan.style.color = 'red'
                }
            })
        })

        registerForm?.addEventListener('submit', e => {
            e.preventDefault()

            const username = $('#username-register')
            const password = $('#password-register')

            fetch('/register',{
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({username, password})
            })
            .then(res => {
                if(res.ok){
                    regsiterFormSapn.innerText = 'Usuario registrado...'
                    regsiterFormSapn.style.color = 'green'
                    setTimeout(() => {
                        window.location.href = '/protected'
                    }, 2000)
                } else {
                    regsiterFormSapn.innerTExt = 'Error al registrar usuario'
                    regsiterFormSapn.style.color = 'red'
                }
            })
        })
    </script>




  



 
